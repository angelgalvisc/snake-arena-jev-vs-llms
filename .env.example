# Copy to .env and fill in the providers you want to race.
# .env is gitignored - never commit real keys.
#   cp .env.example .env && $EDITOR .env && set -a && . ./.env && set +a
#
# Only the providers you actually put in --lineup need a key.

# TypeSafe (Jev)    https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Anthropic         https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only needed when the key is not scoped to a workspace.
# Console -> Settings -> Workspaces. This is an identifier, not a secret.
ANTHROPIC_WORKSPACE_ID=

# OpenAI            https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Moonshot (Kimi)   https://platform.kimi.ai/console/api-keys
MOONSHOT_API_KEY=
